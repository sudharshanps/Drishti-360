# DRISHTI 360 Environment Configuration Example
# Copy to .env for local or Docker deployment. Never commit real secrets.

# PostgreSQL (Docker / Production)
POSTGRES_DB=drishti360
POSTGRES_USER=drishti
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql+psycopg2://drishti:change_me_in_production@postgres:5432/drishti360

# Security
SECRET_KEY=replace_with_a_secure_random_hex_string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Application URLs
FRONTEND_URL=http://localhost:5173
PUBLIC_VERIFY_BASE_URL=http://localhost:5173/verify

# Optional external mandi market API key (leave empty to use sample dataset)
AGMARKNET_API_KEY=

# Upload directory (set to mounted persistent disk path in production, e.g. /var/data/uploads)
UPLOAD_DIR=
MAX_UPLOAD_MB=10
ENABLE_DOCS=false

# Frontend API base URL (used at Vite build/dev time)
VITE_API_BASE_URL=http://localhost:8000
