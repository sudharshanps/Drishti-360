# DRISHTI 360 Backend Environment Variables
APP_NAME="DRISHTI 360 – AI-Powered Farm-to-Market Intelligence Platform"
APP_ENV=development
API_PREFIX=/api

# PostgreSQL Connection String
DATABASE_URL=postgresql+psycopg2://drishti:drishti_pass@localhost:5432/drishti360

# Security
SECRET_KEY=replace_with_a_secure_random_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Origins (comma-separated) & Public URLs
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_VERIFY_BASE_URL=http://localhost:5173/verify

# Storage & Upload Limits
UPLOAD_DIR=
MAX_UPLOAD_MB=10
ENABLE_DOCS=true

# Optional Mandi API Key
AGMARKNET_API_KEY=
